{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/patrick-lim-1008/CodexStatus/blob/main/Documentation/plugin-manifest.schema.json",
  "title": "CodexStatus PluginKit v1 Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "identifier", "name", "version", "minimumHostVersion",
    "author", "summary", "symbolName", "kind", "capabilities", "privacyDescription"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "identifier": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(\\.[A-Za-z0-9][A-Za-z0-9-]*){2,}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,3}$" },
    "minimumHostVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,3}$" },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 280 },
    "symbolName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "kind": { "enum": ["native", "resourcePack"] },
    "entryPoint": { "type": "string", "minLength": 1, "maxLength": 100 },
    "capabilities": {
      "type": "array",
      "maxItems": 24,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "permissions": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "reason"],
        "properties": {
          "identifier": {
            "enum": [
              "readTaskActivity", "openCodexTasks", "createEphemeralSideConversation",
              "useModelQuota", "providePrompts", "writeClipboard", "postNotifications",
              "networkAccess"
            ]
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "privacyDescription": { "type": "string", "maxLength": 500 }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "native" } } },
      "then": { "required": ["entryPoint"] }
    },
    {
      "properties": { "permissions": {
        "contains": { "properties": { "identifier": { "const": "readTaskActivity" } }, "required": ["identifier"] },
        "minContains": 0, "maxContains": 1
      } }
    },
    {
      "properties": { "permissions": {
        "contains": { "properties": { "identifier": { "const": "openCodexTasks" } }, "required": ["identifier"] },
        "minContains": 0, "maxContains": 1
      } }
    },
    {
      "properties": { "permissions": {
        "contains": { "properties": { "identifier": { "const": "createEphemeralSideConversation" } }, "required": ["identifier"] },
        "minContains": 0, "maxContains": 1
      } }
    },
    {
      "properties": { "permissions": {
        "contains": { "properties": { "identifier": { "const": "useModelQuota" } }, "required": ["identifier"] },
        "minContains": 0, "maxContains": 1
      } }
    },
    {
      "properties": { "permissions": {
        "contains": { "properties": { "identifier": { "const": "providePrompts" } }, "required": ["identifier"] },
        "minContains": 0, "maxContains": 1
      } }
    },
    {
      "properties": { "permissions": {
        "contains": { "properties": { "identifier": { "const": "writeClipboard" } }, "required": ["identifier"] },
        "minContains": 0, "maxContains": 1
      } }
    },
    {
      "properties": { "permissions": {
        "contains": { "properties": { "identifier": { "const": "postNotifications" } }, "required": ["identifier"] },
        "minContains": 0, "maxContains": 1
      } }
    },
    {
      "properties": { "permissions": {
        "contains": { "properties": { "identifier": { "const": "networkAccess" } }, "required": ["identifier"] },
        "minContains": 0, "maxContains": 1
      } }
    }
  ]
}
